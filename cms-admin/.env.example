# Copy this file to .env.local for local development (npm run dev).
# Obtain these values from Firebase Console -> Project settings -> Your apps (Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional but strongly recommended: comma-separated list of authorized Google emails.
# Example: VITE_ALLOWED_EMAIL=yourname@gmail.com
VITE_ALLOWED_EMAIL=

# Copy this file to .env.local for local development (npm run dev).
# Obtain these values from Firebase Console -> Project settings -> Your apps (Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore Database ID (defaults to "portfolio" if omitted)
VITE_FIRESTORE_DATABASE_ID=portfolio

# Authorized Google email allowlist (comma-separated)
# Example: VITE_ALLOWED_EMAIL=yourname@gmail.com
VITE_ALLOWED_EMAIL=

# ------------------------------------------------------------------
# Server-side only variables (used by server.mjs, NEVER prefixed with VITE_)
# Do NOT commit real tokens! Set GITHUB_DEPLOY_PAT as a Secret in Firebase App Hosting.
# ------------------------------------------------------------------
# GITHUB_DEPLOY_PAT=
# GITHUB_OWNER=Balalachen
# GITHUB_REPO=Balalachen.github.io
# GITHUB_WORKFLOW_ID=main.yml
# GITHUB_REF=master
